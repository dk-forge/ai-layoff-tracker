# Railway environment variables — set these in Railway dashboard → Project → Variables.
# This file documents them; the pipeline reads os.environ, not a .env file.

# OpenRouter API key (openrouter.ai/keys) — extraction runs on DeepSeek-V3
# (deepseek/deepseek-chat) via https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# NewsAPI.org key. Free tier: 100 req/day, ~24h article delay, truncated content.
NEWSAPI_KEY=

# WordPress site that hosts the ai-layoff-tracker plugin (no trailing slash)
WP_SITE_URL=https://asktherecruiter.com/blog

# Shown in wp-admin → Tools → AI Layoff Tracker after plugin activation.
# Sent as the X-Layoff-API-Key header on /add and /check-duplicate.
WP_API_KEY=

# Reviewed official company newsroom / investor-relations RSS or Atom feeds.
# JSON array; leave [] until feeds have been vetted. Example:
# [{"name":"Example Corp","company_name":"Example Corp","url":"https://investor.example.com/rss","country":"United States","ticker":"EXMP"}]
PRESS_RELEASE_FEEDS=[]

# SEC requires a descriptive User-Agent with contact info on every request.
EDGAR_USER_AGENT=AiLayoffTracker contact@asktherecruiter.com
